{
  "expo": {
    "name": "fortibody",
    "slug": "fortibody",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "src/assets/**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "FortiBody needs camera access to scan barcodes for nutrition tracking."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.bgadd.fortibody",
      "permissions": ["android.permission.CAMERA"]
    },
    "extra": {
      "eas": {
        "projectId": "1cce3f78-1a9a-43b3-b3ed-0d8ac84dac42"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FortiBody to access your camera for barcode scanning."
        }
      ],
      "expo-font"
    ],
    "newArchEnabled": true
  }
}
